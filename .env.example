# Optional for process boot /health. Required for /ready success and data APIs.
# Railway provides postgres:// or postgresql://; the app normalizes to asyncpg.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/health_db
INGEST_API_KEY=dev-ingest-key-change-me
READ_API_KEY=dev-read-key-change-me
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
DB_ECHO=false
# Postgres statement_timeout for Query API reads (milliseconds).
QUERY_STATEMENT_TIMEOUT_MS=10000
# Interactive /docs and /openapi.json. Blank = off in production, on otherwise.
# ENABLE_API_DOCS=true
