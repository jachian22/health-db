# MCP service only. Never commit real secrets.
# Cursor receives MCP_API_KEY only. This service also needs READ_API_KEY
# to call the Query API; do not give READ_API_KEY to Cursor.
MCP_API_KEY=change-me-mcp-key
READ_API_KEY=change-me-read-key
QUERY_API_BASE_URL=http://127.0.0.1:8000
MCP_SERVICE_NAME=health-db
QUERY_API_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
# Optional comma-separated Host values for DNS-rebinding protection.
# MCP_ALLOWED_HOSTS=your-mcp-host.up.railway.app
# Optional extra Origin allowlist. Missing Origin is always allowed (Cursor).
# MCP_ALLOWED_ORIGINS=
