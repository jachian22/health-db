# ML extraction client. Never commit real secrets.
# Calls the existing health-db Query API; Postgres is not accessed directly.
HEALTH_API_URL=http://127.0.0.1:8000
HEALTH_API_READ_KEY=change-me-read-key

# Optional. QUERY_API_BASE_URL / READ_API_KEY are accepted as aliases
# so a local MCP/.env can be reused.
# QUERY_API_BASE_URL=http://127.0.0.1:8000
# READ_API_KEY=change-me-read-key

HEALTH_API_TIMEOUT_SECONDS=30
